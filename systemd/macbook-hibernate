#!/bin/sh
# MacBookPro14,2: prepare and finish hibernation (S4).
#
# WLAN: unbind brcmfmac before S4 and put the device into D3hot; without a
#   driver it would stay in D0 (measured: about 1.3 W during hibernation).
#   Bound across S4, its firmware writes to stale DMA addresses after resume
#   (IOMMU faults, dead WLAN). After resume: D0, then bind again.
# T1:   Like macOS, send ASOC.SOCW(0) before and SOCW(1) after hibernation and
#   restart the T1Bridge services. Linux runs _PTS/_WAK for S4, which report the
#   sleep state to the EC; without SOCW(1) the Touch Bar and Touch ID stay dark.
# s2idle is handled by the macbook-s2idle-powersave hook.
set -u

tag=macbook-hibernate
wlan=0000:02:00.0
drv=/sys/bus/pci/drivers/brcmfmac
mark=/run/macbook-hibernate-wlan.unbound
socw_mod=/usr/local/lib/macbook/$(uname -r)/mbp142_t1_socw.ko
socw=/sys/module/mbp142_t1_socw/parameters/socw

log() { logger -t "$tag" -- "$*"; }

[ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = MacBookPro14,2 ] || exit 0
action=${SYSTEMD_SLEEP_ACTION:-${2:-}}
case "$action" in hibernate|hybrid-sleep) ;; *) exit 0 ;; esac

t1_wake() {
    [ -e "$socw" ] || insmod "$socw_mod" 2>/dev/null
    if [ -w "$socw" ] && printf 1 > "$socw"; then
        log "T1: SOCW(1) sent, result $(cat /sys/module/mbp142_t1_socw/parameters/socw_result)"
    else
        log "T1: SOCW(1) not possible"
    fi
    # The services still hold their connection from before hibernation. The
    # keybag relay may fail once on wake and is restarted by systemd; what
    # matters is the state a few seconds later. The session's Touch Bar
    # renderer reconnects on its own.
    t1_units="t1-ncm-ready@eth0.service t1-xart-storage@eth0.service t1-touchbar-hw.service t1bridge-keybag.service"
    # shellcheck disable=SC2086
    systemctl restart $t1_units 2>/dev/null
    sleep 5
    # shellcheck disable=SC2086
    if systemctl is-active --quiet $t1_units; then
        log "T1: services restarted and active"
    else
        log "T1: not all services active: $(systemctl is-active $t1_units | tr '\n' ' ')"
    fi
}

case "${1:-}" in
    pre)
        if [ -e "$drv/$wlan" ]; then
            if printf %s "$wlan" > "$drv/unbind"; then
                : > "$mark"
                setpci -s 02:00.0 CAP_PM+4.w=0003:0003 2>/dev/null
                log "WLAN unbound before $action, PMCSR $(setpci -s 02:00.0 CAP_PM+4.w 2>/dev/null)"
            else
                log "WLAN could not be unbound before $action"
            fi
        fi
        # Stop the keybag relay cleanly instead of letting it fail on the T1
        # connection that drops during resume. t1_wake starts it again.
        systemctl stop t1bridge-keybag.service 2>/dev/null
        [ -e "$socw" ] || insmod "$socw_mod" 2>/dev/null
        if [ -w "$socw" ] && printf 0 > "$socw"; then
            log "T1: SOCW(0) sent, result $(cat /sys/module/mbp142_t1_socw/parameters/socw_result)"
        fi
        ;;
    post)
        if [ -e "$mark" ]; then
            rm -f "$mark"
            setpci -s 02:00.0 CAP_PM+4.w=0000:0003 2>/dev/null
            sleep 0.1
            if [ ! -e "$drv/$wlan" ]; then
                if printf %s "$wlan" > "$drv/bind"; then
                    log "WLAN bound again after $action"
                else
                    log "WLAN could not be bound after $action"
                fi
            fi
        fi
        t1_wake
        ;;
esac
exit 0
