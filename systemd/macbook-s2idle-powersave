#!/bin/sh
# s2idle power saving for MacBookPro14,2.
# The configuration must explicitly opt in. This hook only handles
# suspend-to-idle; hibernation and S3/deep sleep are intentionally excluded.

set -u

tag=macbook-s2idle-powersave
config=/etc/macbook-s2idle-powersave.conf
state=/run/macbook-s2idle-powersave
disabled=/etc/macbook-s2idle-powersave.disabled

log()
{
    logger -t "$tag" -- "$*"
}

thunderbolt_l1()
{
    /usr/bin/python3 -I - "$1" "$state/thunderbolt-l1.json" <<'PY'
from contextlib import ExitStack
import json
import os
from pathlib import Path
import sys

devices = {
    "0000:00:1c.4": (0x9d14, 0x40), "0000:03:00.0": (0x1578, 0xc0),
    "0000:00:1d.0": (0x9d18, 0x40), "0000:79:00.0": (0x1578, 0xc0),
}
drivers = {
    "0000:05:00.0": "thunderbolt", "0000:06:00.0": "xhci_hcd",
    "0000:7b:00.0": "thunderbolt", "0000:7c:00.0": "xhci_hcd",
}
pci = Path("/sys/bus/pci/devices")
action, journal_path = sys.argv[1:]
journal = Path(journal_path)
mask = 0x0002


def read_config(fd, offset, size):
    data = os.pread(fd, size, offset)
    if len(data) != size or data == b"\xff" * size:
        raise OSError(f"PCIe config unreadable at {offset:#x}")
    return int.from_bytes(data, "little")


def open_port(address, stack):
    device, cap = devices[address]
    fd = os.open(pci / address / "config", os.O_RDWR)
    stack.callback(os.close, fd)
    if (read_config(fd, 0, 4) != (device << 16 | 0x8086)
            or read_config(fd, cap, 1) != 0x10):
        raise RuntimeError(f"Unexpected PCI identity at {address}")
    return fd, cap


def set_l1(fd, cap, value):
    offset = cap + 0x10
    current = read_config(fd, offset, 2)
    target = (current & ~mask) | (value & mask)
    if target != current:
        if os.pwrite(fd, target.to_bytes(2, "little"), offset) != 2:
            raise OSError("Short Link Control write")
    if read_config(fd, offset, 2) != target:
        raise OSError("Link Control verification failed")


def restore():
    original = json.loads(journal.read_text())
    if set(original) != set(devices) or any(
            type(value) is not int or not 0 <= value <= 0xffff for value in original.values()):
        raise RuntimeError("Invalid Thunderbolt Link Control journal")
    errors = []
    for address in reversed(devices):
        try:
            with ExitStack() as stack:
                set_l1(*open_port(address, stack), original[address])
        except (OSError, RuntimeError) as exc:
            errors.append(f"{address}: {exc}")
    if errors:
        raise RuntimeError(", ".join(errors))
    journal.unlink()


def enable():
    for address, driver in drivers.items():
        if (pci / address / "driver").resolve().name != driver:
            raise RuntimeError(f"Expected {driver} at {address}")
    for root, bridge in (("0000:00:1c.4", "0000:03:00.0"), ("0000:00:1d.0", "0000:79:00.0")):
        if (pci / bridge).resolve().parent != (pci / root).resolve():
            raise RuntimeError(f"Unexpected Thunderbolt topology at {root}")
    for router in Path("/sys/bus/thunderbolt/devices").glob("*"):
        if not router.name.endswith("-0") and (router / "authorized").is_file():
            raise RuntimeError("An external Thunderbolt router is present")
    for connector in Path("/sys/class/drm").glob("card*-*/status"):
        if "-eDP-" in connector.parent.name or connector.read_text().strip() != "connected":
            continue
        # The internal T1 Touch Bar also advertises a connected DRM output.
        if "-USB-" in connector.parent.name:
            card = connector.parent.name.split("-", 1)[0]
            interface = (Path("/sys/class/drm") / card / "device").resolve()
            usb = interface.parent
            if ((interface / "driver").resolve().name == "appletbdrm"
                    and (pci / "0000:00:14.0").resolve() in usb.parents
                    and (usb / "idVendor").read_text().strip() == "05ac"
                    and (usb / "idProduct").read_text().strip() == "8600"):
                continue
        raise RuntimeError("An external display is connected")
    with ExitStack() as stack:
        opened = {}
        original = {}
        for address in devices:
            port = pci / address
            if ((port / "d3cold_allowed").read_text().strip() != "0"
                    or (port / "power_state").read_text().strip() != "D0"
                    or (port / "power/control").read_text().strip() != "on"):
                raise RuntimeError(f"Unexpected PCI power configuration at {address}")
            fd, cap = opened[address] = open_port(address, stack)
            control = original[address] = read_config(fd, cap + 0x10, 2)
            if (control & 0x13) or not (read_config(fd, cap + 0x0c, 4) & 0x800):
                raise RuntimeError(f"Unexpected PCIe Link Control or capability at {address}")
        temp = journal.with_suffix(".tmp")
        temp.write_text(json.dumps(original))
        temp.replace(journal)
        try:
            # Enable root before bridge, restore in the opposite order.
            for fd, cap in opened.values():
                set_l1(fd, cap, mask)
        except (OSError, RuntimeError):
            restore()
            raise


try:
    if action == "pre":
        enable()
    else:
        restore()
except (OSError, RuntimeError, ValueError) as exc:
    sys.exit(str(exc))
PY
}

snapshot()
{
    name=$1
    file="$state/$name"
    {
        date --iso-8601=ns
        printf 'mem_sleep='; cat /sys/power/mem_sleep 2>/dev/null || true
        printf 'battery_status='; cat /sys/class/power_supply/BAT0/status 2>/dev/null || true
        printf 'battery_capacity='; cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || true
        printf 'battery_charge_uah='; cat /sys/class/power_supply/BAT0/charge_now 2>/dev/null || true
        printf 'battery_voltage_uv='; cat /sys/class/power_supply/BAT0/voltage_now 2>/dev/null || true
        printf 's0_residency_us='; cat /sys/kernel/debug/pmc_core/slp_s0_residency_usec 2>/dev/null || true
        printf 'keyboard_backlight='; cat /sys/class/leds/spi::kbd_backlight/brightness 2>/dev/null || true
        cat /sys/kernel/debug/pmc_core/package_cstate_show 2>/dev/null || true
        for device in 0000:02:00.0 0000:05:00.0 0000:06:00.0 0000:7b:00.0 0000:7c:00.0 0000:00:14.0; do
            link="/sys/bus/pci/devices/$device/driver"
            if [ -L "$link" ]; then
                printf '%s_driver=%s\n' "$device" "$(basename "$(readlink -f "$link")")"
            else
                printf '%s_driver=none\n' "$device"
            fi
        done
    } > "$file"
}

unbind_if_bound()
{
    device=$1
    expected=$2
    link="/sys/bus/pci/devices/$device/driver"
    [ -L "$link" ] || return 0
    actual=$(basename "$(readlink -f "$link")")
    if [ "$actual" != "$expected" ]; then
        log "skip unbind $device: expected $expected, found $actual"
        return 0
    fi
    printf '%s' "$device" > "/sys/bus/pci/drivers/$expected/unbind"
    : > "$state/unbound-$device-$expected"
    log "unbound $device from $expected"
}

bind_if_marked()
{
    device=$1
    driver=$2
    marker="$state/unbound-$device-$driver"
    [ -e "$marker" ] || return 0
    [ -e "/sys/bus/pci/devices/$device" ] || {
        log "cannot restore missing PCI device $device"
        return 1
    }
    if [ ! -L "/sys/bus/pci/devices/$device/driver" ]; then
        printf '%s' "$device" > "/sys/bus/pci/drivers/$driver/bind" || {
            log "failed to restore $device to $driver"
            return 1
        }
    fi
    log "restored $device to $driver"
}

external_usb_on_managed_controllers()
{
    found=1
    for dev in /sys/bus/usb/devices/[0-9]*-*; do
        [ -f "$dev/idVendor" ] || continue
        path=$(readlink -f "$dev")
        case "$path" in
            *'/0000:06:00.0/'*|*'/0000:7c:00.0/'*)
                log "external USB present: $(basename "$dev") $(cat "$dev/idVendor"):$(cat "$dev/idProduct")"
                found=0
                ;;
        esac
    done
    return "$found"
}

[ -r /sys/class/dmi/id/product_name ] || exit 0
[ "$(cat /sys/class/dmi/id/product_name)" = MacBookPro14,2 ] || exit 0
# Retry an interrupted rollback before an old state directory can be removed,
# and restore on resume even if the hook was disabled while suspended.
if [ -f "$state/thunderbolt-l1.json" ]; then
    if detail=$(thunderbolt_l1 post 2>&1); then
        log "Thunderbolt L1 Link Control restored"
    else
        log "Thunderbolt L1 restore failed: $detail"
        [ "${1:-}" != pre ] || exit 0
    fi
fi
[ -e "$disabled" ] && exit 0
[ -r "$config" ] || exit 0

# shellcheck disable=SC1090
. "$config"
[ "${ENABLED:-0}" = 1 ] || exit 0

[ "${ALLOW_REGULAR_BOOT:-0}" = 1 ] || exit 0

sleep_action=${SYSTEMD_SLEEP_ACTION:-${2:-}}
[ "$sleep_action" = suspend ] || exit 0
grep -q '\[s2idle\]' /sys/power/mem_sleep || exit 0

mode=${MODE:-wifi}
require_empty=${REQUIRE_EXTERNAL_USB_EMPTY:-1}

case ${1:-} in
    pre)
        rm -rf "$state"
        mkdir -p "$state"
        snapshot pre
        log "pre-s2idle power save begins (mode=$mode)"

        if [ "$mode" = wifi ] && [ "${THUNDERBOLT_L1:-0}" = 1 ]; then
            if detail=$(thunderbolt_l1 pre 2>&1); then
                log "Thunderbolt L1 enabled on both links"
            else
                log "Thunderbolt L1 skipped or rolled back: $detail"
            fi
        fi

        # PowerDevil did not consistently blank this LED in s2idle. Preserve
        # the user's value and force it off for the complete sleep interval.
        if [ -w /sys/class/leds/spi::kbd_backlight/brightness ]; then
            cat /sys/class/leds/spi::kbd_backlight/brightness > "$state/kbd-backlight"
            printf '0' > /sys/class/leds/spi::kbd_backlight/brightness
            log "keyboard backlight forced off"
        fi

        # This custom driver intentionally keeps Wi-Fi in D0 for normal
        # suspend reliability. In wifi/full mode, remove it completely and
        # recreate it after resume. Controller-only mode keeps Wi-Fi as the
        # recovery connection.
        case "$mode" in
            wifi|full)
                unbind_if_bound 0000:02:00.0 brcmfmac
                ;;
        esac

        case "$mode" in
            controllers|full)
            if [ "$require_empty" = 1 ] && external_usb_on_managed_controllers; then
                : > "$state/controllers-skipped-external-usb"
                log "controller parking skipped because external USB is attached"
            else
                # Park downstream USB first, then both Alpine Ridge hosts.
                # The internal 0000:00:14.0 xHCI/T1 path is never touched.
                unbind_if_bound 0000:06:00.0 xhci_hcd
                unbind_if_bound 0000:7c:00.0 xhci_hcd
                unbind_if_bound 0000:05:00.0 thunderbolt
                unbind_if_bound 0000:7b:00.0 thunderbolt
            fi
                ;;
        esac
        log "pre-s2idle power save complete"
        ;;
    post)
        [ -d "$state" ] || exit 0
        log "post-s2idle restore begins"

        # Restore parent controllers before their xHCI children.
        bind_if_marked 0000:05:00.0 thunderbolt || true
        bind_if_marked 0000:7b:00.0 thunderbolt || true
        sleep 1
        bind_if_marked 0000:06:00.0 xhci_hcd || true
        bind_if_marked 0000:7c:00.0 xhci_hcd || true
        sleep 1
        bind_if_marked 0000:02:00.0 brcmfmac || true
        udevadm settle --timeout=15 || log "udev settle timed out"
        if [ -r "$state/kbd-backlight" ] && [ -w /sys/class/leds/spi::kbd_backlight/brightness ]; then
            cat "$state/kbd-backlight" > /sys/class/leds/spi::kbd_backlight/brightness
            log "keyboard backlight restored"
        fi
        snapshot post
        log "post-s2idle restore complete"
        ;;
esac

exit 0
