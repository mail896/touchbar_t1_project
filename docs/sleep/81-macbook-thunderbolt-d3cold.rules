# MacBookPro14,2: preserve power for the two internal Alpine Ridge hierarchies.
# New PCI devices only. Do not trigger this on a damaged resumed device.
ACTION!="add", GOTO="macbook_tb_d3cold_end"
SUBSYSTEM!="pci", GOTO="macbook_tb_d3cold_end"
ENV{.macbook_tb_vendor}="$attr{[dmi/id]sys_vendor}"
ENV{.macbook_tb_product}="$attr{[dmi/id]product_name}"
ENV{.macbook_tb_vendor}!="Apple Inc.", GOTO="macbook_tb_d3cold_end"
ENV{.macbook_tb_product}!="MacBookPro14,2", GOTO="macbook_tb_d3cold_end"
DEVPATH=="/devices/pci0000:00/0000:00:1c.4", ATTR{vendor}=="0x8086", ATTR{device}=="0x9d14", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1c.4/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]", ATTR{vendor}=="0x8086", ATTR{device}=="0x1578", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1c.4/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]", ATTR{vendor}=="0x8086", ATTR{device}=="0x15d3", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1c.4/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]", ATTR{vendor}=="0x8086", ATTR{device}=="0x15d2", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1c.4/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]", ATTR{vendor}=="0x8086", ATTR{device}=="0x15d4", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1d.0", ATTR{vendor}=="0x8086", ATTR{device}=="0x9d18", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1d.0/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]", ATTR{vendor}=="0x8086", ATTR{device}=="0x1578", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1d.0/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]", ATTR{vendor}=="0x8086", ATTR{device}=="0x15d3", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1d.0/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]", ATTR{vendor}=="0x8086", ATTR{device}=="0x15d2", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
DEVPATH=="/devices/pci0000:00/0000:00:1d.0/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]/0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]", ATTR{vendor}=="0x8086", ATTR{device}=="0x15d4", TEST=="d3cold_allowed", ATTR{d3cold_allowed}="0"
LABEL="macbook_tb_d3cold_end"
