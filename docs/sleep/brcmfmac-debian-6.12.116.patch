--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -17,6 +17,8 @@
 #include <linux/io.h>
 #include <linux/random.h>
 #include <linux/unaligned.h>
+#include <linux/dmi.h>
+#include <linux/suspend.h>
 
 #include <soc.h>
 #include <chipcommon.h>
@@ -42,6 +44,12 @@
 #include "chip.h"
 #include "core.h"
 #include "common.h"
+
+/* Disabled by default; must be selected when the module is loaded. */
+static bool mbp142_s2idle_keep_d0;
+module_param(mbp142_s2idle_keep_d0, bool, 0444);
+MODULE_PARM_DESC(mbp142_s2idle_keep_d0,
+		"Keep MacBookPro14,2 BCM43602 in D0 during s2idle (experimental)");
 
 
 enum brcmf_pcie_state {
@@ -2608,6 +2616,29 @@
 
 	devinfo->state = BRCMFMAC_PCIE_STATE_DOWN;
 
+	/*
+	 * Opt-in local experiment for this board and s2idle only. Saving
+	 * here, after the firmware D3 ACK, makes the PCI core retain D0.
+	 * Deep sleep, hibernation and all other boards remain unchanged.
+	 */
+	if (mbp142_s2idle_keep_d0 &&
+	    pm_suspend_target_state == PM_SUSPEND_TO_IDLE &&
+	    dmi_match(DMI_SYS_VENDOR, "Apple Inc.") &&
+	    dmi_match(DMI_PRODUCT_NAME, "MacBookPro14,2") &&
+	    devinfo->pdev->vendor == PCI_VENDOR_ID_BROADCOM &&
+	    devinfo->pdev->device == 0x43ba &&
+	    devinfo->pdev->subsystem_vendor == PCI_VENDOR_ID_APPLE &&
+	    devinfo->pdev->subsystem_device == 0x0157) {
+		int err = pci_save_state(devinfo->pdev);
+
+		if (err)
+			pci_warn(devinfo->pdev,
+				 "s2idle D0 quirk: PCI state save failed (%d)\n", err);
+		else
+			pci_info(devinfo->pdev,
+				 "MacBookPro14,2: keeping BCM43602 in D0 for s2idle\n");
+	}
+
 	return 0;
 }
 
