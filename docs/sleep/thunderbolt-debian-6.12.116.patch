+static bool tb_switch_apple_s2idle_skip_lc_sleep(struct tb_switch *sw,
+						 bool runtime)
+{
+	struct device *dev = &sw->tb->nhi->pdev->dev;
+	struct pci_dev *pdev, *downstream, *upstream, *root_port;
+
+	if (!mbp142_s2idle_lc_skip || runtime ||
+	    sw != sw->tb->root_switch || tb_route(sw) ||
+	    pm_suspend_target_state != PM_SUSPEND_TO_IDLE ||
+	    !pm_suspend_no_platform())
+		return false;
+
+	if (!dmi_match(DMI_SYS_VENDOR, "Apple Inc.") ||
+	    !dmi_match(DMI_PRODUCT_NAME, "MacBookPro14,2") ||
+	    !dev_is_pci(dev))
+		return false;
+
+	pdev = to_pci_dev(dev);
+	if (pdev->vendor != PCI_VENDOR_ID_INTEL ||
+	    pdev->device != PCI_DEVICE_ID_INTEL_ALPINE_RIDGE_C_4C_NHI)
+		return false;
+
+	/* Match the internal three-level topology, not a tunneled host card. */
+	downstream = pci_upstream_bridge(pdev);
+	if (!downstream || downstream->vendor != PCI_VENDOR_ID_INTEL ||
+	    downstream->device != PCI_DEVICE_ID_INTEL_ALPINE_RIDGE_C_4C_BRIDGE)
+		return false;
+
+	upstream = pci_upstream_bridge(downstream);
+	if (!upstream || upstream->vendor != PCI_VENDOR_ID_INTEL ||
+	    upstream->device != PCI_DEVICE_ID_INTEL_ALPINE_RIDGE_4C_BRIDGE)
+		return false;
+
+	root_port = pci_upstream_bridge(upstream);
+	return root_port && root_port->vendor == PCI_VENDOR_ID_INTEL &&
+	       pci_domain_nr(root_port->bus) == 0 && !root_port->bus->number &&
+	       (root_port->device == 0x9d14 || root_port->device == 0x9d18);
+}
+
 /**
