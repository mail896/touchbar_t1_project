+static int appletbdrm_setup_dma_device(struct usb_interface *intf,
+				      struct drm_device *drm)
+{
+	struct device *dma_dev = usb_intf_get_dma_device(intf);
+
+	if (!dma_dev) {
+		drm_warn(drm, "buffer sharing not supported");
+		return 0;
+	}
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 16, 0)
+	/* PRIME import needs the USB host controller's DMA device. */
+	drm_to_adev(drm)->dma_dev = dma_dev;
+	return drmm_add_action_or_reset(drm, appletbdrm_put_dma_device, dma_dev);
+#else
+	drm_dev_set_dma_dev(drm, dma_dev);
+	put_device(dma_dev);
+	return 0;
+#endif
+}
