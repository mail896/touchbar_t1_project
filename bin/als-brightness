#!/usr/bin/python3 -I
"""Automatic display brightness from the ambient light sensor (MacBookPro14,2).

Two modes, kept in ~/.config/als-brightness.mode ("auto" / "manual"). The
file is shared by this service, the AUTO switch on the Touch Bar (the sun in
front of the brightness slider of t1-touchbar-kde) and als-brightness-toggle.

- AUTO: brightness follows the light along a fixed curve plus a fixed offset
  (state file, default -5). Switching AUTO on goes straight to the curve value;
  the previous manual setting does not count. Nothing is learned.
- Manual: the service does not adjust anything and releases the sensor.
- Adjusting by hand (Touch Bar slider or keys, KDE slider) switches to manual.
  The Touch Bar renderer writes that itself; as a fallback the service treats
  foreign kernel values that do not come from KDE the same way.

The backlight is written through logind (Session.SetBrightness), like the
Touch Bar does. Not through KDE: KDE does not pick up changes made by others
and animates from its stale value on its next write, which shows as a twitch.
KDE does however write its own stale value back (profile switch between AC
and battery, wake-up from idle dimming); in AUTO the service then restores
the curve value right away.

Disable: systemctl --user disable --now als-brightness.service
"""
import glob
import json
import math
import os
import sys
import time

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

MODE_FILE = os.path.expanduser("~/.config/als-brightness.mode")
STATE = os.path.expanduser("~/.config/als-brightness.json")
DEFAULT_OFFSET = -5.0     # percentage points added to the curve unless stored
# (log10(lux+1), percent)
CURVE = [(0.0, 12.0), (1.0, 28.0), (2.0, 48.0), (3.0, 78.0), (3.6, 100.0)]
MIN_PERCENT, MAX_PERCENT = 3.0, 100.0
DARK_X = 0.78             # log10(5+1): flat below ~5 lux (sensor noise)
THRESHOLD = 3.0           # percentage points; smaller deviations are ignored
LIGHT_DEADBAND = 0.2      # log10(lux+1): adjust only after this much light change
BRIGHTEN_AFTER = 1        # seconds a deviation must last before brightening
DIM_AFTER = 4             # seconds a deviation must last before dimming
EMA_UP = 0.7              # smoothing in the log domain per second (brighter)
EMA_DOWN = 0.5            # same (darker)
RAMP_STEPS = 12
RAMP_MS = 40
HW_POLL_MS = 200          # sampling of the kernel value
# KDE idle dimming (Plasma 6.3.6, dimdisplay.cpp): one step, multiplier 0.3 on
# the hardware value, KDE's value stays; keyboard backlight goes to 0.
DIM_FACTOR = 0.3
KEYBOARD = "/sys/class/leds/spi::kbd_backlight/brightness"
QUIET_AFTER_SET = 0.5     # s, do not check the kernel value right after our write
KDE_WINDOW = 3.0          # s after a KDE signal/profile switch: no manual change
PROFILE_WINDOW = 3.0      # s, KDE profile switch


def log(*a):
    print(*a, flush=True)


def curve(x):
    x = max(x, DARK_X)
    if x <= CURVE[0][0]:
        return CURVE[0][1]
    for (x0, y0), (x1, y1) in zip(CURVE, CURVE[1:]):
        if x <= x1:
            return y0 + (y1 - y0) * (x - x0) / (x1 - x0)
    return CURVE[-1][1]


def read_mode():
    try:
        with open(MODE_FILE) as f:
            return "manual" if f.read().strip() == "manual" else "auto"
    except OSError:
        return None


def write_mode(mode):
    try:
        os.makedirs(os.path.dirname(MODE_FILE), exist_ok=True)
        tmp = MODE_FILE + ".new"
        with open(tmp, "w") as f:
            f.write(mode + "\n")
        os.replace(tmp, MODE_FILE)
    except OSError as e:
        log("Mode not saved:", e)


def read_iio_lux():
    """Lux straight from the iio device "als" (raw * scale + offset), or None."""
    for d in glob.glob("/sys/bus/iio/devices/iio:device*"):
        try:
            if open(d + "/name").read().strip() != "als":
                continue
            raw = float(open(d + "/in_illuminance_raw").read())
            try:
                scale = float(open(d + "/in_illuminance_scale").read())
            except OSError:
                scale = 1.0
            try:
                offset = float(open(d + "/in_illuminance_offset").read())
            except OSError:
                offset = 0.0
            return max(0.0, (raw + offset) * scale)
        except (OSError, ValueError):
            continue
    return None


class Controller:
    def __init__(self):
        self.sys = dbus.SystemBus()
        self.ses = dbus.SessionBus()
        self.offset = self._load_offset()
        self.logx = None          # smoothed log10(lux+1)
        self.rawx = None          # last sensor value log10(lux+1)
        self.logx_applied = None  # light value at the last adjustment
        self.active = False       # sensor claimed
        self.applied = None       # last set/known brightness in %
        self.deviating_for = 0
        self.ramp = None
        self.max = 10000
        self._display = None
        self._display_name = None
        self.last_set = 0.0
        self.profile_time = -100.0
        self.kde_signal_time = -100.0
        self.pending_hw = None    # foreign kernel value waiting to be stable
        self.dimmed = False
        self._session = None
        self.hw = None
        self.hw_max = 0
        self.no_sensor_logged = False
        self.sleeping = False
        self.ticks = 0
        self.immediate = False    # after switching AUTO on, adjust without delay
        self.fresh = False        # fresh light value since claiming the sensor
        self.mode = read_mode()
        if self.mode is None:
            self.mode = "auto"
            write_mode(self.mode)
        log("Mode:", self.mode)
        self._pick_backlight()

        self.sys.add_signal_receiver(
            self._sensor_changed, "PropertiesChanged",
            "org.freedesktop.DBus.Properties", "net.hadess.SensorProxy",
            "/net/hadess/SensorProxy")
        self.sys.add_signal_receiver(
            self._proxy_owner, "NameOwnerChanged", "org.freedesktop.DBus",
            arg0="net.hadess.SensorProxy")
        self.sys.add_signal_receiver(
            self._prepare_sleep, "PrepareForSleep", "org.freedesktop.login1.Manager",
            "org.freedesktop.login1", "/org/freedesktop/login1")
        self.sys.add_signal_receiver(
            self._logind_props, "PropertiesChanged",
            "org.freedesktop.DBus.Properties", "org.freedesktop.login1",
            "/org/freedesktop/login1")
        self.ses.add_signal_receiver(
            self._kde_brightness, "BrightnessChanged",
            "org.kde.ScreenBrightness", None, "/org/kde/ScreenBrightness")
        for sig in ("profileChanged", "configurationReloaded"):
            self.ses.add_signal_receiver(
                self._profile, sig, "org.kde.Solid.PowerManagement", None,
                "/org/kde/Solid/PowerManagement")
        GLib.timeout_add_seconds(1, self._tick)
        GLib.timeout_add(HW_POLL_MS, self._hw_tick)

    def _pick_backlight(self):
        """Like KDE: firmware before platform before raw (6.12: acpi_video0)."""
        rank = {"firmware": 0, "platform": 1, "raw": 2}
        found = []
        for d in glob.glob("/sys/class/backlight/*"):
            try:
                kind = open(d + "/type").read().strip()
            except OSError:
                kind = "raw"
            found.append((rank.get(kind, 3), d))
        if not found:
            return False
        self.hw = sorted(found)[0][1]
        self.hw_max = int(open(self.hw + "/max_brightness").read())
        log("Backlight:", self.hw)
        return True

    # ---- state ----------------------------------------------------------
    def _load_offset(self):
        try:
            with open(STATE) as f:
                return float(json.load(f)["offset"])
        except Exception:
            return DEFAULT_OFFSET

    def to_manual(self, reason):
        if self.mode == "manual":
            return
        self.mode = "manual"
        write_mode("manual")
        log("Manual:", reason)
        self._apply_mode()

    def _apply_mode(self):
        if self.mode == "auto":
            self.applied = None
            if not self.lid_closed() and not self.sleeping:
                self.claim()
        else:
            self.ramp = None
            self.release("manual")

    def _check_mode_file(self):
        new = read_mode() or "auto"
        if new == self.mode:
            return
        old, self.mode = self.mode, new
        log("Mode:", old, "->", new)
        if new == "auto":
            self.immediate = True     # go to the curve value right away
            self.offset = self._load_offset()
        self._apply_mode()

    # ---- KDE brightness (read only) -------------------------------------
    def display(self):
        if self._display is None:
            o = self.ses.get_object("org.kde.ScreenBrightness",
                                    "/org/kde/ScreenBrightness")
            names = o.Get("org.kde.ScreenBrightness", "DisplaysDBusNames",
                          dbus_interface="org.freedesktop.DBus.Properties")
            name = None
            for n in names:
                d = self.ses.get_object("org.kde.ScreenBrightness",
                                        "/org/kde/ScreenBrightness/" + n)
                if d.Get("org.kde.ScreenBrightness.Display", "IsInternal",
                         dbus_interface="org.freedesktop.DBus.Properties"):
                    name = n
                    break
            if name is None:
                raise RuntimeError("no internal display")
            self._display_name = name
            self._display = self.ses.get_object(
                "org.kde.ScreenBrightness", "/org/kde/ScreenBrightness/" + name)
            self.max = int(self._display.Get(
                "org.kde.ScreenBrightness.Display", "MaxBrightness",
                dbus_interface="org.freedesktop.DBus.Properties"))
        return self._display

    def kde_percent(self):
        v = self.display().Get("org.kde.ScreenBrightness.Display", "Brightness",
                               dbus_interface="org.freedesktop.DBus.Properties")
        return 100.0 * int(v) / self.max

    def _kde_brightness(self, name, value, source, context):
        if self._display_name is not None and name != self._display_name:
            return
        self.kde_signal_time = time.monotonic()
        self.ramp = None
        # KDE slider = manual change; a profile switch is not (its signal
        # arrives shortly before or after)
        GLib.timeout_add(1500, self._check_kde_signal, self.kde_signal_time)

    def _check_kde_signal(self, t):
        if abs(self.profile_time - t) >= PROFILE_WINDOW and self.mode == "auto":
            self.to_manual("KDE slider")
        return False

    def _profile(self, *args):
        self.profile_time = time.monotonic()

    # ---- hardware via logind --------------------------------------------
    def session(self):
        if self._session is None:
            m = self.sys.get_object("org.freedesktop.login1",
                                    "/org/freedesktop/login1")
            u = m.GetUser(dbus.UInt32(os.getuid()),
                          dbus_interface="org.freedesktop.login1.Manager")
            sid, path = self.sys.get_object("org.freedesktop.login1", u).Get(
                "org.freedesktop.login1.User", "Display",
                dbus_interface="org.freedesktop.DBus.Properties")
            self._session = self.sys.get_object("org.freedesktop.login1", path)
        return self._session

    def read_hw(self):
        return int(open(self.hw + "/brightness").read())

    def hw_value(self, p):
        return max(1, int(round(self.hw_max * p / 100.0)))

    def set_percent(self, p):
        self.last_set = time.monotonic()
        self.session().SetBrightness(
            "backlight", os.path.basename(self.hw), dbus.UInt32(self.hw_value(p)),
            dbus_interface="org.freedesktop.login1.Session")

    def _keyboard_off(self):
        try:
            return int(open(KEYBOARD).read()) == 0
        except OSError:
            return True

    def _hw_tick(self):
        try:
            self._check_hw()
        except dbus.DBusException as e:
            log("D-Bus error:", e.get_dbus_message())
            self._display = None
            self._session = None
        except Exception as e:
            log("Error:", e)
        return True

    def _check_hw(self):
        """AUTO only: classify foreign changes of the kernel value.
        - KDE idle dimming (0.3 x KDE value, keyboard light off): pause.
        - Kernel value = KDE value (profile switch, wake-up): curve right away.
        - Otherwise (Touch Bar without mode report): manual.
        A value is classified once it is stable for two samples (KDE animates
        its transitions)."""
        if self.mode != "auto" or not self.hw or self.ramp is not None:
            return
        now = time.monotonic()
        if now - self.last_set < QUIET_AFTER_SET:
            return
        hw = self.read_hw()
        if self.applied is None:
            self._adopt(hw)
            return
        if abs(hw - self.hw_value(self.applied)) <= 1:
            self.pending_hw = None
            self.dimmed = False
            return
        if self.pending_hw != hw:
            self.pending_hw = hw
            return
        self._check_mode_file()      # the Touch Bar reports manual before writing
        if self.mode != "auto":
            return
        kde_hw = self.kde_percent() / 100.0 * self.hw_max
        if abs(hw - DIM_FACTOR * kde_hw) <= 1.5 and self._keyboard_off():
            if not self.dimmed:
                log("KDE dims the display, control pauses")
            self.dimmed = True
            return
        self.pending_hw = None
        self.dimmed = False
        if abs(hw - kde_hw) <= 1.5:
            if now - self.kde_signal_time < KDE_WINDOW and \
                    abs(self.profile_time - self.kde_signal_time) >= PROFILE_WINDOW:
                return               # KDE slider: _check_kde_signal switches mode
            target = self._target()
            if target is None:
                self._adopt(hw)
                return
            log(f"KDE set {100.0 * hw / self.hw_max:.0f} %, back to {target:.0f} %")
            self.set_percent(target)
            self.applied = target
            self.logx_applied = self.logx
            return
        if now - self.kde_signal_time < KDE_WINDOW or now - self.profile_time < KDE_WINDOW:
            self._adopt(hw)
            return                   # KDE transition, not the user
        self._adopt(hw)
        self.to_manual(f"foreign change to {self.applied:.0f} %")

    def _adopt(self, hw):
        """Take a foreign kernel value as the current state; the light deadband
        does not apply then, so the curve takes over again."""
        self.applied = 100.0 * hw / self.hw_max
        self.logx_applied = None

    # ---- sensor ---------------------------------------------------------
    def proxy(self):
        return self.sys.get_object("net.hadess.SensorProxy",
                                   "/net/hadess/SensorProxy")

    def claim(self):
        if self.active or self.mode != "auto":
            return
        try:
            p = self.proxy()
            if not p.Get("net.hadess.SensorProxy", "HasAmbientLight",
                         dbus_interface="org.freedesktop.DBus.Properties"):
                if not self.no_sensor_logged:
                    log("No light sensor reported, retrying every 10 s")
                    self.no_sensor_logged = True
                return
            p.ClaimLight(dbus_interface="net.hadess.SensorProxy")
            self.active = True
            self.no_sensor_logged = False
            self.logx = None
            self.rawx = None
            self.logx_applied = None
            self.deviating_for = 0
            self.fresh = False        # only our own reading after 1 s counts
            log("Light sensor claimed")
            # Right after ClaimLight the proxy still reports an old value.
            GLib.timeout_add(1000, lambda: (self._read_light(), False)[1])
        except dbus.DBusException as e:
            if not self.no_sensor_logged:
                log("ClaimLight failed:", e.get_dbus_message())
                self.no_sensor_logged = True

    def _read_light(self):
        """iio-sensor-proxy reports LightLevel only on change, and right after
        ClaimLight its value is stale. So 1 s after claiming, and while no value
        has arrived, read the sensor directly (iio sysfs)."""
        if not self.active:
            return
        value = read_iio_lux()
        if value is None:
            try:
                value = float(self.proxy().Get(
                    "net.hadess.SensorProxy", "LightLevel",
                    dbus_interface="org.freedesktop.DBus.Properties"))
            except dbus.DBusException:
                return
        self._sensor_changed(None, {"LightLevel": value}, [])

    def release(self, reason):
        if not self.active:
            return
        self.active = False
        self.ramp = None
        try:
            self.proxy().ReleaseLight(dbus_interface="net.hadess.SensorProxy")
        except dbus.DBusException:
            pass
        log("Light sensor released:", reason)

    def _sensor_changed(self, iface, changed, invalidated):
        if not self.active or "LightLevel" not in changed:
            return
        x = math.log10(max(0.0, float(changed["LightLevel"])) + 1.0)
        self.rawx = x
        if self.logx is None or iface is None:
            self.logx = x             # our own reading is fresh, restart smoothing
        if iface is None:
            self.fresh = True

    def _proxy_owner(self, name, old, new):
        self.active = False
        if new and not self.lid_closed():
            GLib.timeout_add_seconds(2, lambda: (self.claim(), False)[1])

    def lid_closed(self):
        try:
            l = self.sys.get_object("org.freedesktop.login1",
                                    "/org/freedesktop/login1")
            return bool(l.Get("org.freedesktop.login1.Manager", "LidClosed",
                              dbus_interface="org.freedesktop.DBus.Properties"))
        except dbus.DBusException:
            return False

    def _prepare_sleep(self, starting):
        self.sleeping = bool(starting)
        if starting:
            self.release("sleep")
        else:
            GLib.timeout_add_seconds(3, self._after_sleep)

    def _after_sleep(self):
        if not self.lid_closed():
            self.applied = None
            self.claim()
        return False

    def _logind_props(self, iface, changed, invalidated):
        if "LidClosed" in changed:
            if changed["LidClosed"]:
                self.release("lid closed")
            else:
                self.applied = None
                self.claim()

    # ---- control --------------------------------------------------------
    def _tick(self):
        self.ticks += 1
        try:
            self._check_mode_file()
            if self.active and self.rawx is None:
                self._read_light()
            if self.ticks % 10 == 0:
                # robustness at boot: backlight or sensor appeared after the service
                if not self.hw:
                    self._pick_backlight()
                if not self.active and not self.sleeping and not self.lid_closed():
                    self.claim()
            self._control()
        except dbus.DBusException as e:
            log("D-Bus error:", e.get_dbus_message())
            self._display = None
            self._session = None
        except Exception as e:
            log("Error:", e)
        return True

    def _target(self):
        if self.logx is None:
            return None
        return max(MIN_PERCENT, min(MAX_PERCENT, curve(self.logx) + self.offset))

    def _control(self):
        if self.mode != "auto" or not self.active or self.logx is None:
            return
        if self.immediate and self.fresh and self.hw:
            # AUTO switched on: go to the curve value once a fresh value is in
            self.immediate = False
            hw = self.read_hw()
            target = self._target()
            self._adopt(hw)
            self.logx_applied = self.logx
            log(f"AUTO: {100.0 * hw / self.hw_max:.0f} % -> {target:.0f} % "
                f"at {10**self.logx - 1:.0f} lux")
            if abs(target - self.applied) >= 1.0:
                self._start_ramp(self.applied, target)
            return
        d = self.rawx - self.logx
        self.logx += (EMA_UP if d > 0 else EMA_DOWN) * d
        if self.ramp is not None or self.dimmed or self.pending_hw is not None:
            self.deviating_for = 0
            return
        if self.applied is None:
            self._adopt(self.read_hw())
        if self.logx_applied is not None and abs(self.logx - self.logx_applied) < LIGHT_DEADBAND:
            self.deviating_for = 0
            return                   # light barely changed (noise in the dark)
        target = self._target()
        diff = target - self.applied
        if abs(diff) < THRESHOLD:
            self.deviating_for = 0
            self.logx_applied = self.logx
            return
        self.deviating_for += 1
        if self.deviating_for < (BRIGHTEN_AFTER if diff > 0 else DIM_AFTER):
            return
        self.deviating_for = 0
        hw = self.read_hw()
        if abs(hw - self.hw_value(self.applied)) > 1:
            return                    # foreign change, let _check_hw handle it
        self.logx_applied = self.logx
        self._start_ramp(100.0 * hw / self.hw_max, target)

    def _start_ramp(self, start, end):
        self.ramp = [start + (end - start) * (i + 1) / RAMP_STEPS
                     for i in range(RAMP_STEPS)]
        GLib.timeout_add(RAMP_MS, self._ramp_step)

    def _ramp_step(self):
        if not self.ramp or self.mode != "auto":
            self.ramp = None
            return False
        p = self.ramp.pop(0)
        try:
            self.set_percent(p)
            self.applied = p
        except dbus.DBusException as e:
            log("Setting failed:", e.get_dbus_message())
            self._session = None
            self.ramp = None
            return False
        if not self.ramp:
            self.ramp = None
            return False
        return True


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    c = Controller()
    if not c.lid_closed():
        c.claim()
    GLib.MainLoop().run()


if __name__ == "__main__":
    sys.exit(main())
