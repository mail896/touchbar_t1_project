#!/bin/sh
# Switches automatic display brightness between AUTO and manual.
# No argument: toggle. "on" (AUTO) / "off" (manual) / "status".
# The mode lives in ~/.config/als-brightness.mode and is shared with the AUTO
# switch on the Touch Bar. Switching AUTO on sets the brightness that suits
# the current light right away.
set -u
SERVICE=als-brightness.service
MODE="$HOME/.config/als-brightness.mode"

notify() {
    notify-send -a "Auto brightness" -i "$1" -t 2500 "$2" "$3" 2>/dev/null || true
}

write() {
    mkdir -p "$(dirname "$MODE")"
    printf '%s\n' "$1" > "$MODE.new" && mv -f "$MODE.new" "$MODE"
}

current() {
    if [ "$(cat "$MODE" 2>/dev/null)" = manual ]; then echo manual; else echo auto; fi
}

on() {
    write auto
    systemctl --user enable --now "$SERVICE" >/dev/null 2>&1
    notify brightness-high "Auto brightness: AUTO" \
        "Brightness follows the light."
}

off() {
    write manual
    notify brightness-low "Auto brightness: manual" \
        "Brightness stays where it is."
}

case "${1:-toggle}" in
    on) on ;;
    off) off ;;
    status) current ;;
    *)
        if [ "$(current)" = auto ] && systemctl --user is-active --quiet "$SERVICE"; then
            off
        else
            on
        fi
        ;;
esac
