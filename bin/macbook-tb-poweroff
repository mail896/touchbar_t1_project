#!/bin/sh
# MacBookPro14,2: load mbp142_tb_poweroff at boot when THUNDERBOLT_POWEROFF=1
# is set in /etc/macbook-s2idle-powersave.conf. The module powers both idle
# Alpine Ridge controllers off during s2idle (and, on request, while awake).
# A failure here never delays the boot.
set -u

tag=macbook-tb-poweroff
config=/etc/macbook-s2idle-powersave.conf
module=/usr/local/lib/macbook/$(uname -r)/mbp142_tb_poweroff.ko

log() { logger -t "$tag" -- "$*"; }

[ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = MacBookPro14,2 ] || exit 0
[ -r "$config" ] || exit 0
# shellcheck disable=SC1090
. "$config"
if [ "${THUNDERBOLT_POWEROFF:-0}" != 1 ]; then
    log "THUNDERBOLT_POWEROFF is not 1, module not loaded"
    exit 0
fi
if [ -d /sys/module/mbp142_tb_poweroff ]; then
    log "module already loaded"
    exit 0
fi
if [ ! -r "$module" ]; then
    log "no module for kernel $(uname -r) at $module"
    exit 0
fi

# The module checks at load time that both NHI and xHCI drivers are bound.
bound() { [ "$(basename "$(readlink "/sys/bus/pci/devices/$1/driver" 2>/dev/null)")" = "$2" ]; }
i=0
until bound 0000:05:00.0 thunderbolt && bound 0000:7b:00.0 thunderbolt &&
      bound 0000:06:00.0 xhci_hcd && bound 0000:7c:00.0 xhci_hcd; do
    i=$((i + 1))
    if [ "$i" -gt 60 ]; then
        log "Thunderbolt drivers not bound after 60 s, module not loaded"
        exit 0
    fi
    sleep 1
done

if insmod "$module" enabled=1; then
    log "mbp142_tb_poweroff loaded"
else
    log "loading mbp142_tb_poweroff failed"
fi
exit 0
