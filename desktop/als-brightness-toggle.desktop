[Desktop Entry]
Type=Application
Name=Auto brightness on/off
Name[de]=Auto-Helligkeit ein/aus
GenericName=Automatic display brightness
GenericName[de]=Automatische Bildschirmhelligkeit
Comment=Turns brightness control by the light sensor on or off
Comment[de]=Schaltet die Helligkeitsregelung nach dem Lichtsensor ein oder aus
Exec=sh -c '"$HOME/.local/bin/als-brightness-toggle"'
Icon=video-display-brightness
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=brightness;light sensor;display;Helligkeit;Lichtsensor;
Actions=On;Off;

[Desktop Action On]
Name=Turn on
Name[de]=Einschalten
Exec=sh -c '"$HOME/.local/bin/als-brightness-toggle" on'

[Desktop Action Off]
Name=Turn off
Name[de]=Ausschalten
Exec=sh -c '"$HOME/.local/bin/als-brightness-toggle" off'
