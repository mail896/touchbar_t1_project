+fn parse_lesson_status(output: &[u8]) -> Option<LessonStatus> {
+    let mut fields = std::str::from_utf8(output).ok()?.split_ascii_whitespace();
+    let phase = fields.next()?;
+    let number = fields.next()?.parse::<u8>().ok()?;
+    let remaining = fields.next()?;
+    if fields.next().is_some() {
+        return None;
+    }
+    let (phase, remaining_seconds) = match (phase, number, remaining) {
+        ("class", 1..=20, seconds) => (LessonPhase::Class(number), Some(seconds.parse().ok()?)),
+        ("break", 1..=20, seconds) => (LessonPhase::Break(number), Some(seconds.parse().ok()?)),
+        ("before", 0, seconds) => (LessonPhase::BeforeSchool, Some(seconds.parse().ok()?)),
+        ("after", 0, "-") => (LessonPhase::AfterSchool, None),
+        ("free", 0, "-") => (LessonPhase::Free, None),
+        _ => return None,
+    };
+    Some(LessonStatus {
+        phase,
+        remaining_seconds,
+    })
