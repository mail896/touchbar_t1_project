new file mode 100644
index 0000000..7921272
--- /dev/null
+++ b/crates/t1-touchbar/src/totp_preview.rs
@@ -0,0 +1,91 @@
+use std::io::{self, Read};
+use std::path::Path;
+use std::process::{Child, Command, Stdio};
+use std::sync::mpsc::{self, Receiver};
+use std::thread;
+use std::time::Duration;
+
+const HELPER_TIMEOUT: Duration = Duration::from_secs(25);
+
+pub(crate) struct TotpPreview {
+    child: Child,
+    result: Receiver<[u8; 6]>,
+    copied: bool,
+    deadline: Duration,
+}
+
+impl TotpPreview {
+    pub(crate) fn start(helper: &Path, now: Duration) -> io::Result<Self> {
+        let mut child = Command::new(helper)
+            .arg("copy")
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()?;
+        let mut output = child.stdout.take().expect("requested pipe");
+        let (sender, result) = mpsc::channel();
+        if let Err(error) = thread::Builder::new()
+            .name("t1-totp-preview".into())
+            .spawn(move || {
+                let mut record = [0; 7];
+                if output.read_exact(&mut record).is_ok()
+                    && let Some(code) = parse_code(record)
+                {
+                    let _ = sender.send(code);
+                }
+            })
+        {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err(error);
+        }
+        Ok(Self {
+            child,
+            result,
+            copied: false,
+            deadline: now + HELPER_TIMEOUT,
+        })
+    }
+
+    pub(crate) fn running(&mut self, now: Duration) -> bool {
+        now < self.deadline && matches!(self.child.try_wait(), Ok(None))
+    }
+
+    pub(crate) fn take_code(&mut self) -> Option<[u8; 6]> {
+        let code = self.result.try_recv().ok()?;
+        self.copied = true;
+        Some(code)
+    }
+
+    pub(crate) const fn copied(&self) -> bool {
+        self.copied
+    }
+}
+
+impl Drop for TotpPreview {
+    fn drop(&mut self) {
+        if matches!(self.child.try_wait(), Ok(None)) {
+            let _ = self.child.kill();
+            let _ = self.child.wait();
+        }
+    }
+}
+
+fn parse_code([digits @ .., newline]: [u8; 7]) -> Option<[u8; 6]> {
+    (newline == b'\n' && digits.iter().all(u8::is_ascii_digit)).then_some(digits)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn accepts_only_a_single_six_digit_record() {
+        let synthetic = [b'0'; 6];
+        let mut record = [b'0'; 7];
+        record[6] = b'\n';
+        assert_eq!(parse_code(record), Some(synthetic));
+        assert_eq!(parse_code(*b"------\n"), None);
+        assert_eq!(parse_code([b'0'; 7]), None);
+    }
+}
