+fn shortcut_url(variable: &str) -> Option<String> {
+    let url = env::var(variable).ok()?;
+    let target = url
+        .strip_prefix("https://")
+        .or_else(|| url.strip_prefix("http://"))?;
+    let authority = target.split(['/', '?', '#']).next()?;
+    (!authority.is_empty() && !authority.contains('@') && !url.chars().any(char::is_whitespace))
+        .then_some(url)
+}
