+) {
+    let mut status = ToolsStatus::default();
+    let mut generation = 0;
+    let mut next_microphone = Instant::now();
+    let mut next_lesson = next_microphone;
+    let Ok(mut requests) = monitor.requests.lock() else {
+        return;
+    };
+    while !requests.closed {
+        if !requests.visible {
+            let Ok(next) = monitor.ready.wait(requests) else {
+                return;
+            };
+            requests = next;
+            continue;
+        }
+
+        let now = Instant::now();
+        if generation != requests.visibility_generation {
+            generation = requests.visibility_generation;
+            status = ToolsStatus::default();
+            next_microphone = now;
+            next_lesson = now;
+        }
+        let refresh_microphone = requests.refresh_microphone || now >= next_microphone;
+        if !refresh_microphone && now < next_lesson {
+            let delay = next_microphone
+                .min(next_lesson)
+                .saturating_duration_since(now);
+            let Ok((next, _)) = monitor.ready.wait_timeout(requests, delay) else {
+                return;
+            };
+            requests = next;
+            continue;
+        }
+        requests.refresh_microphone = false;
+        drop(requests);
+        // The two queries have separate deadlines. A mute action wakes only
+        // the microphone poll and leaves the lesson cadence untouched.
+        if refresh_microphone {
+            status.microphone_muted = read_microphone();
+            next_microphone = Instant::now() + STATUS_INTERVAL;
+        } else {
+            status.lesson = read_lesson();
+            next_lesson = Instant::now() + STATUS_INTERVAL;
+        }
+        let Ok(next) = monitor.requests.lock() else {
+            return;
+        };
+        requests = next;
+        // Ignore readings from a previous opening of Tools and any microphone
+        // snapshot superseded by an action while a query was running.
+        if !requests.closed
+            && requests.visible
+            && generation == requests.visibility_generation
+            && !requests.refresh_microphone
+        {
+            requests.latest = Some(status);
+        }
+    }
+}
