+fn draw_outline_symbol(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    color: Rgb,
+    shape: impl Fn(f64, f64) -> bool,
+) -> Result<(), FramebufferError> {
+    let size = scaled_dimension(36, bounds.height, bounds.width.min(bounds.height));
+    draw_outline_at(
+        frame,
+        Rectangle {
+            x: bounds.x + (bounds.width - size) / 2,
+            y: bounds.y + (bounds.height - size) / 2,
+            width: size,
+            height: size,
+        },
+        color,
+        shape,
+    )
+}
+
+fn draw_outline_at(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    color: Rgb,
+    shape: impl Fn(f64, f64) -> bool,
+) -> Result<(), FramebufferError> {
+    let mask = rasterize(bounds.width, bounds.height, |x, y| {
+        shape(
+            x / f64::from(bounds.width) - 0.5,
+            y / f64::from(bounds.height) - 0.5,
+        )
+    });
+    frame.blend_mask(bounds, &mask, color)
+}
+
+/// The sun with a filled disc: automatic brightness is on.
+fn is_auto_sun_pixel(x: f64, y: f64) -> bool {
+    x.hypot(y) <= 0.25 || is_sun_pixel(x, y)
+}
+
+fn is_sun_pixel(x: f64, y: f64) -> bool {
+    let radius = x.hypot(y);
+    let x = x.abs();
+    let y = y.abs();
+    (0.18..=0.25).contains(&radius)
+        || ((0.32..=0.46).contains(&radius) && (x.min(y) <= 0.035 || (x - y).abs() <= 0.045))
+}
+
+fn is_keyboard_light_pixel(x: f64, y: f64) -> bool {
+    let x = x.abs();
+    let height = 0.27 - y;
+    let radius = x.hypot(height);
+    ((0.23..=0.31).contains(&y) && x <= 0.42)
+        || (height >= 0.15
+            && (0.25..=0.42).contains(&radius)
+            && (x <= 0.04 || (x - height).abs() <= 0.048))
+}
+
+fn is_speaker_pixel(x: f64, y: f64) -> bool {
+    let y = y.abs();
+    let cone = (-0.26..=-0.07).contains(&x) && y <= 0.13 + (x + 0.26) * 0.84;
+    let base = (-0.43..=-0.26).contains(&x) && y <= 0.13;
+    let wave = x > -0.01
+        && y <= 0.9 * (x + 0.14)
+        && ((0.24..=0.30).contains(&(x + 0.14).hypot(y))
+            || (0.45..=0.51).contains(&(x + 0.14).hypot(y)));
+    base || cone || wave
+}
+
+fn draw_terminal_symbol(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    color: Rgb,
+) -> Result<(), FramebufferError> {
+    let inset = bounds.width / 12;
+    let available = bounds.width - 2 * inset;
+    let maximum = bounds.height.min(available / 2);
+    if maximum == 0 {
+        return Ok(());
+    }
+    let size = scaled_dimension(48, bounds.height, maximum);
+    let icon = Rectangle {
+        x: bounds.x + inset,
+        y: bounds.y + (bounds.height - size) / 2,
+        width: size,
+        height: size,
+    };
+    draw_tux(frame, icon, color)?;
+    draw_panel_text(
+        frame,
+        Rectangle {
+            x: icon.x + size + inset,
+            width: available - size - inset,
+            ..bounds
+        },
+        ">_",
+        color,
+    )
+}
+
+fn draw_tux(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    white: Rgb,
+) -> Result<(), FramebufferError> {
+    const BLACK: Rgb = Rgb {
+        red: 10,
+        green: 10,
+        blue: 12,
+    };
+    draw_outline_at(frame, bounds, BLACK, |x, y| {
+        ellipse(x, y + 0.24, 0.24, 0.22)
+            || ellipse(x, y - 0.13, 0.29, 0.31)
+            || ellipse(x.abs() - 0.28 - 0.28 * y, y - 0.10, 0.12, 0.23)
+    })?;
+    draw_outline_at(frame, bounds, white, |x, y| {
+        ellipse(x, y - 0.16, 0.21, 0.24) || ellipse(x.abs() - 0.085, y + 0.245, 0.072, 0.10)
+    })?;
+    draw_outline_at(frame, bounds, BLACK, |x, y| {
+        ellipse(x.abs() - 0.057, y + 0.23, 0.029, 0.052)
+    })?;
+    draw_outline_at(frame, bounds, ACCENT_YELLOW, |x, y| {
+        ellipse(x, y + 0.124, 0.145, 0.059) || ellipse(x.abs() - 0.206, y - 0.39, 0.156, 0.077)
+    })
+}
+
+fn ellipse(x: f64, y: f64, radius_x: f64, radius_y: f64) -> bool {
+    (x / radius_x).powi(2) + (y / radius_y).powi(2) <= 1.0
+}
+
+fn is_back_pixel(x: f64, y: f64) -> bool {
+    let y = y.abs();
+    ((-0.28..=0.39).contains(&x) && y <= 0.042) || (y <= 0.27 && (x + 0.28 - y).abs() <= 0.057)
+}
+
+fn is_ellipsis_pixel(x: f64, y: f64) -> bool {
+    x.hypot(y) <= 0.078 || (x.abs() - 0.3).hypot(y) <= 0.078
+}
+
+fn is_microphone_pixel(x: f64, y: f64) -> bool {
+    let capsule_y = y.clamp(-0.29, 0.035);
+    let capsule = x.hypot(y - capsule_y) <= 0.13;
+    let cradle = y >= -0.01 && (0.215..=0.28).contains(&x.hypot(y + 0.01));
+    let stem = x.abs() <= 0.035 && (0.24..=0.39).contains(&y);
+    let base = x.abs() <= 0.16 && (0.365..=0.43).contains(&y);
+    capsule || cradle || stem || base
+}
+
+fn is_microphone_muted_pixel(x: f64, y: f64) -> bool {
+    let slash = (x + y).abs();
+    (slash <= 0.049 && x.abs() <= 0.42) || (slash >= 0.13 && is_microphone_pixel(x, y))
+}
