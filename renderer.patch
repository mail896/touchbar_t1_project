+fn parse_status_with_battery(output: &[u8]) -> Result<DesktopState, DesktopProviderError> {
+    let Some(separator) = output.iter().position(|byte| *byte == b'\n') else {
+        return Err(DesktopProviderError::Status);
+    };
+    let mut state = parse_status(&output[..separator])?;
+    let battery =
+        std::str::from_utf8(&output[separator + 1..]).map_err(|_| DesktopProviderError::Status)?;
+    let mut fields = battery.split_ascii_whitespace();
+    let (Some(percentage), Some(power), None) = (fields.next(), fields.next(), fields.next())
+    else {
+        return Err(DesktopProviderError::Status);
+    };
+    let percentage = percentage
+        .parse::<f64>()
+        .ok()
+        .filter(|value| (0.0..=100.0).contains(value))
+        .map(|value| value.round() as u8);
+    state.battery = Some(DesktopBattery {
+        percentage,
+        external_power: parse_flag(power)?,
+    });
+    Ok(state)
+}
