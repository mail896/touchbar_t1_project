diff --git a/crates/t1-touchbar/src/auto_brightness.rs b/crates/t1-touchbar/src/auto_brightness.rs
new file mode 100644
index 0000000..9c310b4
--- /dev/null
+++ b/crates/t1-touchbar/src/auto_brightness.rs
@@ -0,0 +1,30 @@
+//! Shared AUTO/manual mode of the automatic display brightness service.
+//!
+//! The mode lives in `~/.config/als-brightness.mode` ("auto" or "manual"). The
+//! brightness service, its menu toggle and this renderer read and write it.
+//! Without the file the service is not set up and no AUTO button is shown.
+
+use std::{env, fs, io::Write, path::PathBuf};
+
+fn path() -> Option<PathBuf> {
+    let home = env::var_os("HOME")?;
+    Some(PathBuf::from(home).join(".config/als-brightness.mode"))
+}
+
+/// Returns `Some(true)` for AUTO, `Some(false)` for manual, `None` without file.
+pub fn read() -> Option<bool> {
+    let text = fs::read_to_string(path()?).ok()?;
+    Some(text.trim() != "manual")
+}
+
+/// Atomically stores the mode. Returns whether it was written.
+pub fn write(auto: bool) -> bool {
+    let Some(path) = path() else {
+        return false;
+    };
+    let temporary = path.with_extension("mode.new");
+    fs::File::create(&temporary)
+        .and_then(|mut file| file.write_all(if auto { b"auto\n" } else { b"manual\n" }))
+        .and_then(|()| fs::rename(&temporary, &path))
+        .is_ok()
+}
diff --git a/crates/t1-touchbar/src/bin/t1-touchbar-kde.rs b/crates/t1-touchbar/src/bin/t1-touchbar-kde.rs
new file mode 100644
index 0000000..7ac09e2
--- /dev/null
+++ b/crates/t1-touchbar/src/bin/t1-touchbar-kde.rs
@@ -0,0 +1,117 @@
+use std::env;
+use std::fs::File;
+use std::io::{BufWriter, Write};
+use std::path::Path;
+use std::process::ExitCode;
+
+use t1_platform::system_brightness::{BrightnessKind, SystemBrightnessControls};
+use t1_touchbar::builtin_renderer;
+use t1_touchbar::desktop_provider::{PROVIDER_ENVIRONMENT, resolve_provider_path};
+use t1_touchbar::framebuffer::Xrgb8888Frame;
+use t1_touchbar::stock_slice::{
+    LessonPhase, LessonStatus, SliderControl, StockBar, StockCapabilities, StockLevels,
+};
+
+fn main() -> ExitCode {
+    let arguments: Vec<_> = env::args_os().skip(1).collect();
+    match arguments.as_slice() {
+        [] => {
+            let value = env::var_os(PROVIDER_ENVIRONMENT);
+            let provider = resolve_provider_path(value.as_deref());
+            builtin_renderer::run_extended_forever(provider.as_deref());
+            ExitCode::SUCCESS
+        }
+        [option, kind] if option == "--brightness-percent" => {
+            let kind = match kind.to_str() {
+                Some("display") => BrightnessKind::Display,
+                Some("keyboard") => BrightnessKind::Keyboard,
+                _ => return usage(),
+            };
+            let Ok(percentage) = SystemBrightnessControls::discover().current_percentage(kind)
+            else {
+                return ExitCode::FAILURE;
+            };
+            println!("{percentage}");
+            ExitCode::SUCCESS
+        }
+        [option, mode, destination] if option == "--preview" => {
+            let Some(mode) = mode.to_str() else {
+                return usage();
+            };
+            let mode = match mode {
+                "main" | "tools" | "keyboard" | "volume" | "function" | "branded"
+                | "branded-tools" | "branded-code" => mode,
+                _ => return usage(),
+            };
+            match write_preview(Path::new(destination), mode) {
+                Ok(()) => ExitCode::SUCCESS,
+                Err(error) => {
+                    eprintln!("t1-touchbar-kde: preview: {error}");
+                    ExitCode::FAILURE
+                }
+            }
+        }
+        _ => usage(),
+    }
+}
+
+fn write_preview(destination: &Path, mode: &str) -> Result<(), Box<dyn std::error::Error>> {
+    const WIDTH: u32 = 2_170;
+    const HEIGHT: u32 = 60;
+    let branded = mode.starts_with("branded");
+    let mut capabilities = StockCapabilities::EXTENDED_CONTROLS
+        | StockCapabilities::DISPLAY_BRIGHTNESS
+        | StockCapabilities::KEYBOARD_BACKLIGHT
+        | StockCapabilities::AUDIO
+        | StockCapabilities::MEDIA;
+    if branded {
+        capabilities = capabilities
+            | StockCapabilities::BRANDED_SHORTCUTS
+            | StockCapabilities::SHORTCUT_ONE
+            | StockCapabilities::SHORTCUT_TWO
+            | StockCapabilities::SCHEDULE
+            | StockCapabilities::TOTP;
+    }
+    let slider = match mode {
+        "keyboard" => Some(SliderControl::KeyboardBacklight),
+        "volume" => Some(SliderControl::Volume),
+        _ => None,
+    };
+    let bar = StockBar::new(WIDTH, HEIGHT, capabilities)?
+        .with_tools(matches!(mode, "tools" | "branded-tools"))
+        .with_open_slider(slider);
+    let levels = StockLevels {
+        display_brightness: Some(64),
+        keyboard_backlight: Some(45),
+        volume: Some(38),
+        microphone_muted: Some(false),
+        cpu_temperature: Some(52),
+        cpu_cores: [Some(18), Some(27)],
+        battery_percentage: Some(66),
+        external_power: true,
+        lesson: branded.then_some(LessonStatus {
+            phase: LessonPhase::Class(2),
+            remaining_seconds: Some(7 * 60),
+        }),
+        totp_code: (mode == "branded-code").then_some(*b"------"),
+        ..StockLevels::default()
+    };
+    let mut pixels = vec![0; (WIDTH * HEIGHT * 4) as usize];
+    let mut frame = Xrgb8888Frame::new(WIDTH, HEIGHT, WIDTH * 4, &mut pixels)?;
+    bar.render(&mut frame, mode == "function", levels)?;
+
+    let mut output = BufWriter::new(File::create_new(destination)?);
+    write!(output, "P6\n{WIDTH} {HEIGHT}\n255\n")?;
+    for &[blue, green, red, _] in frame.as_bytes().as_chunks::<4>().0 {
+        output.write_all(&[red, green, blue])?;
+    }
+    output.flush()?;
+    Ok(())
+}
+
+fn usage() -> ExitCode {
+    eprintln!(
+        "usage: t1-touchbar-kde [--brightness-percent display|keyboard]\n       t1-touchbar-kde --preview MODE OUTPUT.ppm\n       MODE: main, tools, keyboard, volume, function, branded, branded-tools, branded-code"
+    );
+    ExitCode::from(2)
+}
