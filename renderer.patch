new file mode 100644
index 0000000..eba7759
--- /dev/null
+++ b/crates/t1-touchbar/src/cpu_usage.rs
@@ -0,0 +1,101 @@
+use std::{collections::BTreeMap, fs};
+
+#[derive(Clone, Copy, Default)]
+struct CpuTicks {
+    total: u64,
+    idle: u64,
+}
+
+pub(crate) struct CoreUsage {
+    physical_cores: BTreeMap<usize, usize>,
+    previous: [Option<CpuTicks>; 2],
+}
+
+impl CoreUsage {
+    pub(crate) fn new() -> Self {
+        let mut physical_cores = BTreeMap::new();
+        if let Ok(devices) = fs::read_dir("/sys/devices/system/cpu") {
+            for device in devices.flatten() {
+                let name = device.file_name();
+                let Some(cpu) = cpu_number(&name.to_string_lossy()) else {
+                    continue;
+                };
+                let Ok(core) = fs::read_to_string(device.path().join("topology/core_id")) else {
+                    continue;
+                };
+                if let Ok(core @ 0..=1) = core.trim().parse::<usize>() {
+                    physical_cores.insert(cpu, core);
+                }
+            }
+        }
+        Self {
+            physical_cores,
+            previous: [None; 2],
+        }
+    }
+
+    pub(crate) fn sample(&mut self) -> [Option<u8>; 2] {
+        let Ok(stat) = fs::read_to_string("/proc/stat") else {
+            return [None; 2];
+        };
+        self.sample_stat(&stat)
+    }
+
+    fn sample_stat(&mut self, stat: &str) -> [Option<u8>; 2] {
+        let mut current = [None; 2];
+        for line in stat.lines().take_while(|line| line.starts_with("cpu")) {
+            let mut fields = line.split_whitespace();
+            let Some(core) = fields
+                .next()
+                .and_then(cpu_number)
+                .and_then(|cpu| self.physical_cores.get(&cpu).copied())
+            else {
+                continue;
+            };
+            let counters: Vec<u64> = fields
+                .take(8)
+                .map_while(|field| field.parse().ok())
+                .collect();
+            if let [_, _, _, idle, iowait, _, _, _] = counters.as_slice() {
+                let ticks = current[core].get_or_insert(CpuTicks::default());
+                ticks.total += counters.iter().sum::<u64>();
+                ticks.idle += idle + iowait;
+            }
+        }
+        let usage = std::array::from_fn(|core| {
+            let old = self.previous[core]?;
+            let new = current[core]?;
+            let total = new.total.checked_sub(old.total)?;
+            let idle = new.idle.checked_sub(old.idle)?;
+            if total == 0 {
+                return None;
+            }
+            u8::try_from((total.saturating_sub(idle) * 100 + total / 2) / total).ok()
+        });
+        self.previous = current;
+        usage
+    }
+}
+
+fn cpu_number(name: &str) -> Option<usize> {
+    name.strip_prefix("cpu")?.parse().ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn aggregates_the_two_logical_threads_of_each_physical_core() {
+        let mut usage = CoreUsage {
+            physical_cores: [(0, 0), (1, 1), (2, 0), (3, 1)].into(),
+            previous: [None; 2],
+        };
+        assert_eq!(usage.sample_stat(
+            "cpu 100 0 0 100 0 0 0 0\ncpu0 0 0 0 100 0 0 0 0\ncpu1 0 0 0 100 0 0 0 0\ncpu2 0 0 0 100 0 0 0 0\ncpu3 0 0 0 100 0 0 0 0\n"
+        ), [None, None]);
+        assert_eq!(usage.sample_stat(
+            "cpu 100 0 0 100 0 0 0 0\ncpu0 100 0 0 100 0 0 0 0\ncpu1 25 0 0 175 0 0 0 0\ncpu2 0 0 0 200 0 0 0 0\ncpu3 25 0 0 175 0 0 0 0\n"
+        ), [Some(50), Some(25)]);
+    }
+}
