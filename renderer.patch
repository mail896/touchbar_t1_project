+fn read_cpu_temperature() -> Option<i16> {
+    for entry in fs::read_dir("/sys/class/hwmon").ok()?.flatten() {
+        let device = entry.path();
+        if fs::read_to_string(device.join("name")).is_ok_and(|name| name.trim() == "coretemp")
+            && fs::read_to_string(device.join("temp1_label"))
+                .is_ok_and(|label| label.trim() == "Package id 0")
+        {
+            let millidegrees: i32 = fs::read_to_string(device.join("temp1_input"))
+                .ok()?
+                .trim()
+                .parse()
+                .ok()?;
+            return i16::try_from(millidegrees / 1000).ok();
+        }
+    }
+    None
+}
+
+fn read_power_status() -> (Option<u8>, bool) {
+    let mut reported_percentage = None;
+    let mut charge = None;
+    let mut charge_full = None;
+    let mut energy = None;
+    let mut energy_full = None;
+    let mut external_power = false;
+    let Some(entries) = fs::read_dir("/sys/class/power_supply").ok() else {
+        return (reported_percentage, external_power);
+    };
+    for entry in entries.flatten() {
+        let device = entry.path();
+        let Some(kind) = fs::read_to_string(device.join("type")).ok() else {
+            continue;
+        };
+        if kind.trim() == "Battery" {
+            reported_percentage = read_power_value(&device.join("capacity"))
+                .and_then(|value| u8::try_from(value.min(100)).ok());
+            charge = read_power_value(&device.join("charge_now"));
+            charge_full = read_power_value(&device.join("charge_full"));
+            energy = read_power_value(&device.join("energy_now"));
+            energy_full = read_power_value(&device.join("energy_full"));
+        } else if fs::read_to_string(device.join("online")).is_ok_and(|value| value.trim() == "1") {
+            external_power = true;
+        }
+    }
+    let percentage = charge
+        .zip(charge_full)
+        .and_then(|(current, full)| relative_charge_percentage(current, full))
+        .or_else(|| {
+            energy
+                .zip(energy_full)
+                .and_then(|(current, full)| relative_charge_percentage(current, full))
+        })
+        .or(reported_percentage);
+    (percentage, external_power)
+}
+
+fn read_power_value(path: &Path) -> Option<u64> {
+    fs::read_to_string(path).ok()?.trim().parse().ok()
+}
+
+fn relative_charge_percentage(current: u64, full: u64) -> Option<u8> {
+    if full == 0 {
+        return None;
+    }
+    let rounded = current.saturating_mul(100).saturating_add(full / 2) / full;
+    u8::try_from(rounded.min(100)).ok()
+}
