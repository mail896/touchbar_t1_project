+    fn draw_cpu_readout(
+        frame: &mut Xrgb8888Frame<'_>,
+        bounds: Rectangle,
+        levels: StockLevels,
+    ) -> Result<(), StockSliceError> {
+        let inside = |x, y, width, height| {
+            let left = scale(x, bounds.width, CPU_READOUT_DESIGN_WIDTH);
+            let top = scale(y, bounds.height, PLATE_HEIGHT);
+            Rectangle {
+                x: bounds.x + left,
+                y: bounds.y + top,
+                width: scale(x + width, bounds.width, CPU_READOUT_DESIGN_WIDTH) - left,
+                height: scale(y + height, bounds.height, PLATE_HEIGHT) - top,
+            }
+        };
+        let temperature = levels.cpu_temperature.map_or_else(
+            || String::from("CPU -- °C"),
+            |value| format!("CPU {value} °C"),
+        );
+        let label = inside(0, 0, 194, PLATE_HEIGHT);
+        stock_art::draw_panel_text(frame, label, &temperature, LABEL)?;
+
+        for ((core, y), usage) in [(1, 4), (2, 32)].into_iter().zip(levels.cpu_cores) {
+            let track = inside(210, y + 7, 180, 10);
+            if track.width != 0 && track.height != 0 {
+                let radius = track.height / 2;
+                stock_art::draw_rounded_plate(frame, track, radius, SLIDER_TRACK)?;
+                if let Some(usage) = usage {
+                    let width = scale(u32::from(usage.min(100)), track.width, 100);
+                    if width != 0 {
+                        let fill = Rectangle { width, ..track };
+                        stock_art::draw_rounded_plate(frame, fill, radius, SLIDER_FILL)?;
+                    }
+                }
+            }
+            let label = usage.map_or_else(
+                || format!("{core} --%"),
+                |usage| format!("{core} {}%", usage.min(100)),
+            );
+            let bounds = inside(399, y, 111, 24);
+            stock_art::draw_panel_text(frame, bounds, &label, LABEL)?;
+        }
+        Ok(())
