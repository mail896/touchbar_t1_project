+use crate::framebuffer::{FramebufferError, Rectangle, Rgb, Xrgb8888Frame};
+
+const WIDTH: u32 = 108;
+const HEIGHT: u32 = 50;
+const PIXELS: [&[u8; (WIDTH * HEIGHT * 4) as usize]; 2] = [
+    include_bytes!("../assets/shortcut-1.rgba"),
+    include_bytes!("../assets/shortcut-2.rgba"),
+];
+
+pub(crate) fn draw(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    index: usize,
+) -> Result<(), FramebufferError> {
+    let pixels = PIXELS[index];
+    let height = (bounds.height * 5 / 6).min(bounds.width * HEIGHT / WIDTH);
+    let width = height * WIDTH / HEIGHT;
+    let left = bounds.x + (bounds.width - width) / 2;
+    let top = bounds.y + (bounds.height - height) / 2;
+    for y in 0..height {
+        let source_y = y * HEIGHT / height;
+        for x in 0..width {
+            let source_x = x * WIDTH / width;
+            let offset = ((source_y * WIDTH + source_x) * 4) as usize;
+            let [red, green, blue, alpha] = pixels[offset..][..4].try_into().expect("RGBA pixel");
+            if alpha != 0 {
+                frame.blend_rectangle(
+                    Rectangle {
+                        x: left + x,
+                        y: top + y,
+                        width: 1,
+                        height: 1,
+                    },
+                    Rgb { red, green, blue },
+                    alpha,
+                )?;
+            }
+        }
+    }
+    Ok(())
+}
