+/// Draws an antialiased battery percentage using compact vector segments.
+pub(crate) fn draw_battery_percentage(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    percentage: u8,
+    color: Rgb,
+) -> Result<(), FramebufferError> {
+    let percentage = percentage.min(100);
+    let digits = percentage.to_string();
+    let digit_count = f64::from(u32::try_from(digits.len()).unwrap_or(3));
+    let digit_width = 0.56;
+    let gap = 0.09;
+    let percent_width = 0.50;
+    let design_width = digit_count * digit_width + digit_count * gap + percent_width;
+    let scale = (f64::from(bounds.width) / design_width).min(f64::from(bounds.height));
+    let left = (f64::from(bounds.width) - design_width * scale) / 2.0;
+    let top = (f64::from(bounds.height) - scale) / 2.0;
+    let mask = rasterize(bounds.width, bounds.height, |x, y| {
+        let design_x = (x - left) / scale;
+        let design_y = (y - top) / scale;
+        if !(0.0..=1.0).contains(&design_y) {
+            return false;
+        }
+        for (index, digit) in (0_u32..).zip(digits.bytes()) {
+            let origin = f64::from(index) * (digit_width + gap);
+            if smooth_digit_contains(digit, design_x - origin, design_y) {
+                return true;
+            }
+        }
+        let percent_left = digit_count * (digit_width + gap);
+        smooth_percent_contains(design_x - percent_left, design_y)
+    });
+    frame.blend_mask(bounds, &mask, color)
+}
+
+/// Draws the antialiased charging bolt used inside the battery.
+pub(crate) fn draw_battery_bolt(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    color: Rgb,
+) -> Result<(), FramebufferError> {
+    const POINTS: [(f64, f64); 6] = [
+        (0.58, 0.02),
+        (0.12, 0.55),
+        (0.43, 0.55),
+        (0.28, 0.98),
+        (0.88, 0.37),
+        (0.54, 0.37),
+    ];
+    let mask = rasterize(bounds.width, bounds.height, |x, y| {
+        let x = x / f64::from(bounds.width);
+        let y = y / f64::from(bounds.height);
+        let mut inside = false;
+        let mut previous = POINTS.len() - 1;
+        for (current, &(current_x, current_y)) in POINTS.iter().enumerate() {
+            let (previous_x, previous_y) = POINTS[previous];
+            if (current_y > y) != (previous_y > y)
+                && x < (previous_x - current_x) * (y - current_y) / (previous_y - current_y)
+                    + current_x
+            {
+                inside = !inside;
+            }
+            previous = current;
+        }
+        inside
+    });
+    frame.blend_mask(bounds, &mask, color)
+}
+
+fn smooth_digit_contains(digit: u8, x: f64, y: f64) -> bool {
+    const LINES: [((f64, f64), (f64, f64)); 7] = [
+        ((0.12, 0.08), (0.44, 0.08)),
+        ((0.49, 0.13), (0.49, 0.45)),
+        ((0.49, 0.55), (0.49, 0.87)),
+        ((0.12, 0.92), (0.44, 0.92)),
+        ((0.07, 0.55), (0.07, 0.87)),
+        ((0.07, 0.13), (0.07, 0.45)),
+        ((0.12, 0.50), (0.44, 0.50)),
+    ];
+    let segments = match digit {
+        b'0' => 0b0011_1111,
+        b'1' => 0b0000_0110,
+        b'2' => 0b0101_1011,
+        b'3' => 0b0100_1111,
+        b'4' => 0b0110_0110,
+        b'5' => 0b0110_1101,
+        b'6' => 0b0111_1101,
+        b'7' => 0b0000_0111,
+        b'8' => 0b0111_1111,
+        b'9' => 0b0110_1111,
+        _ => 0,
+    };
+    LINES.iter().enumerate().any(|(index, &(start, end))| {
+        segments & (1 << index) != 0 && line_distance(x, y, start, end) <= 0.055
+    })
+}
+
+fn smooth_percent_contains(x: f64, y: f64) -> bool {
+    let upper = (x - 0.13).hypot(y - 0.24);
+    let lower = (x - 0.38).hypot(y - 0.76);
+    (0.055..=0.105).contains(&upper)
+        || (0.055..=0.105).contains(&lower)
+        || line_distance(x, y, (0.09, 0.84), (0.42, 0.16)) <= 0.025
+}
+
+fn line_distance(x: f64, y: f64, start: (f64, f64), end: (f64, f64)) -> f64 {
+    let delta_x = end.0 - start.0;
+    let delta_y = end.1 - start.1;
+    let length_squared = delta_x * delta_x + delta_y * delta_y;
+    let position =
+        (((x - start.0) * delta_x + (y - start.1) * delta_y) / length_squared).clamp(0.0, 1.0);
+    (x - (start.0 + position * delta_x)).hypot(y - (start.1 + position * delta_y))
+}
+
+pub(crate) fn draw_panel_text_runs(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    runs: &[(&str, Rgb)],
+) -> Result<(), FramebufferError> {
+    let count = u32::try_from(
+        runs.iter()
+            .map(|(text, _)| text.chars().count())
+            .sum::<usize>(),
+    )
+    .map_err(|_| FramebufferError::InvalidGeometry)?;
+    let columns = count
+        .checked_mul(6)
+        .ok_or(FramebufferError::InvalidGeometry)?
+        .saturating_sub(1);
+    if columns == 0 || columns > bounds.width || bounds.height < 7 {
+        return Ok(());
+    }
+    let pixel = scaled_dimension(4, bounds.height, bounds.height)
+        .min(bounds.width / columns)
+        .min(bounds.height / 7);
+    let width = columns * pixel;
+    let height = 7 * pixel;
+    let left = bounds.x + (bounds.width - width) / 2;
+    let top = bounds.y + (bounds.height - height) / 2;
+    let mut offset = 0;
+    for &(text, color) in runs {
+        let count =
+            u32::try_from(text.chars().count()).map_err(|_| FramebufferError::InvalidGeometry)?;
+        if count == 0 {
+            continue;
+        }
+        let span = count * 6;
+        draw_panel_text_run(
+            frame,
+            Rectangle {
+                x: left + offset * pixel,
+                y: top,
+                width: (span - 1) * pixel,
+                height,
+            },
+            text,
+            pixel,
+            color,
+        )?;
+        offset += span;
+    }
+    Ok(())
+}
+
+fn draw_panel_text_run(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    text: &str,
+    pixel: u32,
+    color: Rgb,
+) -> Result<(), FramebufferError> {
+    let stride = usize::try_from(bounds.width).map_err(|_| FramebufferError::InvalidGeometry)?;
+    let pixel = usize::try_from(pixel).map_err(|_| FramebufferError::InvalidGeometry)?;
+    let length = stride
+        .checked_mul(7 * pixel)
+        .ok_or(FramebufferError::InvalidGeometry)?;
+    let mut mask = vec![0; length];
+    for (index, glyph) in text.chars().map(panel_glyph).enumerate() {
+        for (row, bits) in glyph.into_iter().enumerate() {
+            for column in 0..5 {
+                if bits & (1 << (4 - column)) != 0 {
+                    let x = (index * 6 + column) * pixel;
+                    for y in row * pixel..(row + 1) * pixel {
+                        let start = y * stride + x;
+                        mask[start..start + pixel].fill(u8::MAX);
+                    }
+                }
+            }
+        }
+    }
+    frame.blend_mask(bounds, &mask, color)
+}
+
+fn panel_glyph(character: char) -> [u8; 7] {
+    match character {
+        '0' => [14, 17, 19, 21, 25, 17, 14],
+        '1' => [4, 12, 4, 4, 4, 4, 14],
+        '2' => [14, 17, 1, 2, 4, 8, 31],
+        '3' => [30, 1, 1, 14, 1, 1, 30],
+        '4' => [2, 6, 10, 18, 31, 2, 2],
+        '5' => [31, 16, 16, 30, 1, 1, 30],
+        '6' => [14, 16, 16, 30, 17, 17, 14],
+        '7' => [31, 1, 2, 4, 8, 8, 8],
+        '8' => [14, 17, 17, 14, 17, 17, 14],
+        '9' => [14, 17, 17, 15, 1, 1, 14],
+        'A' => [14, 17, 17, 31, 17, 17, 17],
+        'B' => [30, 17, 17, 30, 17, 17, 30],
+        'C' => [14, 17, 16, 16, 16, 17, 14],
+        'D' => [30, 17, 17, 17, 17, 17, 30],
+        'E' => [31, 16, 16, 30, 16, 16, 31],
+        'F' => [31, 16, 16, 30, 16, 16, 16],
+        'I' => [14, 4, 4, 4, 4, 4, 14],
+        'L' => [16, 16, 16, 16, 16, 16, 31],
+        'N' => [17, 25, 25, 21, 19, 19, 17],
+        'P' => [30, 17, 17, 30, 16, 16, 16],
+        'R' => [30, 17, 17, 30, 20, 18, 17],
+        'S' => [15, 16, 16, 14, 1, 1, 30],
+        'T' => [31, 4, 4, 4, 4, 4, 4],
+        'U' => [17, 17, 17, 17, 17, 17, 14],
+        'Z' => [31, 1, 2, 4, 8, 16, 31],
+        'e' => [0, 0, 14, 17, 31, 16, 14],
+        'i' => [4, 0, 12, 4, 4, 4, 14],
+        't' => [8, 8, 30, 8, 8, 9, 6],
+        '.' => [0, 0, 0, 0, 0, 4, 4],
+        ':' => [0, 4, 4, 0, 4, 4, 0],
+        '%' => [17, 18, 2, 4, 8, 9, 17],
+        '>' => [16, 8, 4, 2, 4, 8, 16],
+        '_' => [0, 0, 0, 0, 0, 0, 31],
+        '-' => [0, 0, 0, 14, 0, 0, 0],
+        '°' => [12, 18, 12, 0, 0, 0, 0],
+        _ => [0; 7],
+    }
+}
