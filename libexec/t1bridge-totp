#!/usr/bin/python3 -B
# SPDX-License-Identifier: MIT
"""Store one selected TOTP in Secret Service and copy its current code."""

import argparse
import base64
import hmac
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
import time
from urllib.parse import parse_qs, unquote, urlsplit

SECRET_TOOL = "/usr/bin/secret-tool"
CLIPBOARD_SECONDS = 15
MIN_VALIDITY_SECONDS = 4


def account_alias():
    alias = os.environ.get("T1BRIDGE_TOTP_ACCOUNT", "default")
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", alias) is None:
        raise ValueError("Invalid account alias")
    return alias


def entry(alias):
    return ["application", "touchbar-t1-project", "account", alias]


def totp_parameters(secret, algorithm, period):
    if not isinstance(secret, str) or not isinstance(algorithm, str):
        raise ValueError("Invalid TOTP parameters")
    if re.fullmatch(r"[A-Za-z2-7]{8,512}={0,6}", secret) is None:
        raise ValueError("Invalid Base32 secret")
    secret = secret.upper().rstrip("=")
    algorithm = algorithm.upper()
    if algorithm not in ("SHA1", "SHA256", "SHA512"):
        raise ValueError("Unsupported algorithm")
    if type(period) is not int or not 5 <= period <= 300:
        raise ValueError("Unsupported period")
    base64.b32decode(secret + "=" * (-len(secret) % 8))
    return {"secret": secret, "algorithm": algorithm, "period": period}


def parameters_from_qr(text):
    uri = urlsplit(text)
    if uri.scheme != "otpauth" or uri.netloc != "totp" or not uri.path or uri.fragment:
        raise ValueError("Expected a TOTP URI")
    values = parse_qs(uri.query, strict_parsing=True, keep_blank_values=True, max_num_fields=16)

    def field(name, default=""):
        items = values.get(name, [default])
        if len(items) != 1 or not items[0]:
            raise ValueError("Invalid or duplicate TOTP field")
        return items[0]

    if field("digits", "6") != "6":
        raise ValueError("Expected six digits")
    parameters = totp_parameters(field("secret"), field("algorithm", "SHA1"), int(field("period", "30")))
    label = "".join(char for char in unquote(uri.path.lstrip("/")) if char.isprintable())
    return parameters, label[:160]


def current_code(parameters, now):
    secret = parameters["secret"]
    key = base64.b32decode(secret + "=" * (-len(secret) % 8))
    period = parameters["period"]
    counter = int(now) // period
    digest = hmac.digest(key, counter.to_bytes(8, "big"), parameters["algorithm"].lower())
    offset = digest[-1] & 15
    number = int.from_bytes(digest[offset:offset + 4], "big") & 0x7fffffff
    return f"{number % 1_000_000:06d}", (counter + 1) * period


def capture_qr():
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    info = runtime.stat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("Runtime directory is not private")
    with tempfile.TemporaryDirectory(prefix="t1bridge-totp-", dir=runtime) as workspace:
        target = Path(workspace) / "qr.png"
        subprocess.run(
            ["/usr/bin/spectacle", "--new-instance", "--background", "--region", "--nonotify",
             "--output", str(target)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            env=dict(os.environ, XDG_CONFIG_HOME=workspace), check=True, timeout=120,
        )
        result = subprocess.run(
            ["/usr/bin/zbarimg", "--nodbus", "--quiet", "--raw", str(target)],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            check=True, timeout=8,
        )
        lines = result.stdout.decode("utf-8").splitlines()
        if len(lines) != 1:
            raise ValueError("Expected one QR code")
        return parameters_from_qr(lines[0])


def setup(alias, session):
    if not sys.stdin.isatty() or not sys.stdout.isatty() or not session.unlocked():
        raise ValueError("Setup needs an unlocked local session and a terminal")
    print("Select only the QR code for the account you want to use.", flush=True)
    parameters, label = capture_qr()
    if input(f"Save or replace the entry '{alias}' with '{label}'? [y/N] ").strip().lower() != "y":
        return 1
    if not session.unlocked():
        return 1
    subprocess.run(
        [SECRET_TOOL, "store", f"--label=Touch Bar TOTP ({alias})", *entry(alias)],
        input=json.dumps(parameters).encode("ascii"),
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True, timeout=30,
    )
    print("Saved in your local keyring.")
    return 0


def copy(alias, session):
    from t1bridge_clipboard import copy_sensitive

    if not stat.S_ISFIFO(os.fstat(sys.stdout.fileno()).st_mode) or not session.unlocked():
        return 1
    result = subprocess.run(
        [SECRET_TOOL, "lookup", *entry(alias)],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        check=True, timeout=8,
    )
    parameters = totp_parameters(**json.loads(result.stdout))
    code, expiry = current_code(parameters, time.time())
    remaining = expiry - time.time()
    if remaining < MIN_VALIDITY_SECONDS:
        time.sleep(max(0, remaining) + 0.15)
        code, expiry = current_code(parameters, time.time())
    if not session.unlocked() or expiry - time.time() < MIN_VALIDITY_SECONDS:
        return 1
    deadline = min(expiry, time.time() + CLIPBOARD_SECONDS)
    return copy_sensitive(code, deadline, session, lambda: print(code, flush=True))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("setup", "copy"))
    action = parser.parse_args().action
    try:
        if os.getuid() == 0 or os.geteuid() != os.getuid():
            raise ValueError("Run as your desktop user")
        from t1bridge_clipboard import Session

        alias, session = account_alias(), Session()
        return setup(alias, session) if action == "setup" else copy(alias, session)
    except (EOFError, OSError, ValueError, KeyError, TypeError, RuntimeError, ImportError,
            subprocess.SubprocessError, KeyboardInterrupt):
        if action == "setup":
            print("Setup stopped. Check the local KDE session, keyring and selected TOTP QR code.",
                  file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
